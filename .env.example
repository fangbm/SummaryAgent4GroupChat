# Windows single-host mode is the default. IPC values are still used by optional API mode.
WECHAT_PIPELINE_IPC_TOKEN=change-me
WECHAT_PIPELINE_DOWNLOAD_SECRET=change-me-download

# Legacy Linux/API mode
LINUX_BOT_CONFIG=config/bot.yaml
LINUX_BOT__WINDOWS_BRIDGE__HOST=127.0.0.1
LINUX_BOT__WINDOWS_BRIDGE__TOKEN=${WECHAT_PIPELINE_IPC_TOKEN}

# Windows
WINDOWS_WORKER_CONFIG=config/worker.yaml
WINDOWS_WORKER__WECHAT__PROVIDER=wxhook
WINDOWS_WORKER__SECURITY__IPC_TOKEN=${WECHAT_PIPELINE_IPC_TOKEN}
WINDOWS_WORKER__SECURITY__DOWNLOAD_SECRET=${WECHAT_PIPELINE_DOWNLOAD_SECRET}
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
IMAGE_API_KEY=sk-...
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1.5
HTTP_PROXY=http://127.0.0.1:7890
