<Page
    x:Class="SummaryAgent4GroupChat.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28">
        <StackPanel Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="仪表盘" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{Binding StatusSummary}" Opacity="0.75" />
            </StackPanel>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding Notice}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StatusCard}"><StackPanel Spacing="8"><TextBlock Text="主程序" Opacity="0.72" /><TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}" /></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource StatusCard}"><StackPanel Spacing="8"><TextBlock Text="配置" Opacity="0.72" /><TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource StatusCard}"><StackPanel Spacing="8"><TextBlock Text="安全" Opacity="0.72" /><TextBlock Text="密钥只在 Rust 控制层中校验与脱敏" TextWrapping="Wrap" /></StackPanel></Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="启动主程序" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="停止主程序" Click="Stop_Click" />
                <Button Content="刷新状态" Click="Refresh_Click" />
            </StackPanel>
            <Border Style="{StaticResource StatusCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="维护操作" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="安装微信运行环境" Click="InstallRuntime_Click" />
                        <Button Content="运行 wxdb init" Click="WxdbInit_Click" />
                        <Button Content="打开输出目录" Click="OpenOutput_Click" />
                    </StackPanel>
                    <TextBlock Text="这两项管理操作会单独申请管理员权限；日常 GUI 与主程序保持普通权限。" Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
