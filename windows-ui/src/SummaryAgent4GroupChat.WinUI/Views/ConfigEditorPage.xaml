<Page
    x:Class="SummaryAgent4GroupChat.WinUI.Views.ConfigEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock x:Name="PageDescription" Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding ValidationMessage}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button Content="校验" Click="Validate_Click" />
            <Button Content="保存并热重载" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="还原磁盘配置" Click="Refresh_Click" />
            <Button Content="打开配置文件" Click="OpenConfig_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1060" Spacing="18" Padding="0,4,12,24">
                <StackPanel x:Name="PlatformPanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="平台与历史记录" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="运行平台" /><ComboBox SelectedValuePath="Content" SelectedValue="{Binding PlatformKind, Mode=TwoWay}"><ComboBoxItem Content="wx" /><ComboBoxItem Content="discord" /></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="每页历史读取条数" /><NumberBox Value="{Binding HistoryPageSize, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="1" /></StackPanel>
                        <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="微信目标群（逗号或换行分隔）" /><TextBox Text="{Binding WeChatGroups, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="Discord 频道 ID（逗号或换行分隔）" /><TextBox Text="{Binding DiscordChannels, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" /></StackPanel>
                        <StackPanel Grid.Row="2" Spacing="5"><TextBlock Text="wxdb 可执行文件" /><TextBox Text="{Binding WxdbExecutable, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5"><TextBlock Text="wxdb 缓存目录（留空使用默认位置）" /><TextBox Text="{Binding WxdbCacheDirectory, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                    <StackPanel Spacing="5"><TextBlock Text="禁用图片总结的群聊（逗号或换行分隔）" /><TextBox Text="{Binding DisabledImageRooms, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" /></StackPanel>
                    <Expander Header="房间策略模板与群组周报" IsExpanded="False">
                        <StackPanel Spacing="10" Padding="0,12,0,0">
                            <TextBlock Text="策略模板 JSON：模板字段可包含 text_summary_enabled、image_summary_enabled、image_caption_enabled、video_caption_enabled、voice_transcription_enabled 和冷却时间。房间通过 room_capabilities.&lt;群名&gt;.template 绑定模板。" TextWrapping="Wrap" Opacity="0.72" />
                            <TextBox Text="{Binding PolicyTemplatesJson, Mode=TwoWay}" FontFamily="Cascadia Mono" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="群组周报 JSON：每个条目包含 enabled、rooms、weekday（周一为 0）、local_hour、local_minute。周报仅聚合运行统计，并向 rooms 中所有群发送图表和简短说明。" TextWrapping="Wrap" Opacity="0.72" />
                            <TextBox Text="{Binding ReportGroupsJson, Mode=TwoWay}" FontFamily="Cascadia Mono" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <Button Content="保存策略与群组" Click="SavePoliciesAndReports_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <StackPanel x:Name="ListenPanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="触发与冷却" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="总结指令（逗号或换行分隔）" /><TextBox Text="{Binding TriggerCommands, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="允许触发的群聊（留空不额外限制）" /><TextBox Text="{Binding WhitelistRooms, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="文字总结成功后冷却（秒）" /><NumberBox Value="{Binding RequestCooldownSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="图片额外冷却（秒）" /><NumberBox Value="{Binding ImageCooldownSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" /></StackPanel>
                        <StackPanel Grid.Row="2" Spacing="5"><CheckBox Content="仅允许指定用户触发" IsChecked="{Binding RequireAllowedUsers, Mode=TwoWay}" /><TextBlock Text="默认关闭。开启后只接受下方用户 ID。" Opacity="0.65" FontSize="12" /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5"><TextBlock Text="允许触发的用户 ID（逗号或换行分隔）" /><TextBox Text="{Binding AllowedUsers, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" /></StackPanel>
                    </Grid>
                    <CheckBox Content="忽略机器人自己发送的消息" IsChecked="{Binding IgnoreSelf, Mode=TwoWay}" />
                    <CheckBox Content="手动总结默认生成图片（带 图片/image/img 参数时反向切换）" IsChecked="{Binding ManualImagesByDefault, Mode=TwoWay}" />
                    <StackPanel Width="260" Spacing="5"><TextBlock Text="默认总结详细度" /><ComboBox SelectedValuePath="Content" SelectedValue="{Binding SummaryDetail, Mode=TwoWay}"><ComboBoxItem Content="concise" /><ComboBoxItem Content="standard" /><ComboBoxItem Content="detailed" /></ComboBox></StackPanel>
                    <Expander Header="群聊每日预算" IsExpanded="False">
                        <StackPanel Spacing="10" Padding="0,12,0,0">
                            <CheckBox Content="启用每日预算（默认关闭，0 为不限）" IsChecked="{Binding BudgetEnabled, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="16"><StackPanel Width="180" Spacing="5"><TextBlock Text="每群总结次数" /><NumberBox Value="{Binding DailySummaryLimit, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" /></StackPanel><StackPanel Width="180" Spacing="5"><TextBlock Text="每群图片投递数" /><NumberBox Value="{Binding DailyImageLimit, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" /></StackPanel><StackPanel Width="180" Spacing="5"><TextBlock Text="每群媒体处理量" /><NumberBox Value="{Binding DailyMediaLimit, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" /></StackPanel></StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <StackPanel x:Name="SchedulePanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="定时总结" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <CheckBox Content="启用定时总结" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="每天执行时间（HH:mm）" /><TextBox Text="{Binding ScheduleTime, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="总结最近（小时）" /><NumberBox Value="{Binding ScheduleRangeHours, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="1" /></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="目标群聊（留空使用平台目标）" /><TextBox Text="{Binding ScheduleRooms, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="20"><CheckBox Content="发送文字总结" IsChecked="{Binding ScheduleSendText, Mode=TwoWay}" /><CheckBox Content="发送图片总结" IsChecked="{Binding ScheduleSendImage, Mode=TwoWay}" /></StackPanel>
                </StackPanel>

                <StackPanel x:Name="ModelsPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="文字总结模型" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="API Key（逗号分隔多 Key）" /><PasswordBox x:Name="LlmApiKeysBox" PasswordChanged="LlmApiKeys_PasswordChanged" PlaceholderText="留空保留当前密钥；输入新值覆盖" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="模型名称" /><TextBox Text="{Binding LlmModel, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="Base URL" /><TextBox Text="{Binding LlmBaseUrl, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="16"><StackPanel Width="150" Spacing="5"><TextBlock Text="总超时（秒）" /><NumberBox Value="{Binding LlmTimeoutSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel><StackPanel Width="150" Spacing="5"><TextBlock Text="最大输出 Token" /><NumberBox Value="{Binding LlmMaxOutputTokens, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel><StackPanel Width="150" Spacing="5"><TextBlock Text="分段并发数" /><NumberBox Value="{Binding LlmChunkConcurrency, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel></StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16"><CheckBox Content="流式接收文字总结" IsChecked="{Binding LlmStreamingEnabled, Mode=TwoWay}" VerticalAlignment="Center" /><StackPanel Width="180" Spacing="5"><TextBlock Text="首个数据包超时（秒）" /><NumberBox Value="{Binding LlmStreamFirstEventTimeoutSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel><StackPanel Width="180" Spacing="5"><TextBlock Text="流中静默超时（秒）" /><NumberBox Value="{Binding LlmStreamIdleTimeoutSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel></StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="图片生成与媒体理解" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="20"><CheckBox Content="启用图片生成" IsChecked="{Binding ImageGenerationEnabled, Mode=TwoWay}" /><CheckBox Content="启用图片转述" IsChecked="{Binding ImageCaptionEnabled, Mode=TwoWay}" /><CheckBox Content="启用视频转述" IsChecked="{Binding VideoCaptionEnabled, Mode=TwoWay}" /><CheckBox Content="启用语音转写" IsChecked="{Binding VoiceTranscriptionEnabled, Mode=TwoWay}" /></StackPanel>
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="图片流水线槽位（0 为按启用群数自动）" TextWrapping="Wrap" /><NumberBox Value="{Binding ImagePipelineMaxConcurrentRequests, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="图片摘要总时限（秒）" /><NumberBox Value="{Binding ImageSummaryTotalTimeoutSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="图片提示词总时限（秒）" /><NumberBox Value="{Binding ImagePromptTotalTimeoutSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="图片接口类型" /><TextBox Text="{Binding ImageProvider, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="图片模型名称" /><TextBox Text="{Binding ImageModel, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="图片 Base URL" /><TextBox Text="{Binding ImageBaseUrl, Mode=TwoWay}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="图片 API Key（逗号分隔多 Key）" /><PasswordBox x:Name="ImageApiKeysBox" PasswordChanged="ImageApiKeys_PasswordChanged" PlaceholderText="留空保留当前密钥；输入新值覆盖" /></StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="图片尺寸" /><TextBox Text="{Binding ImageSize, Mode=TwoWay}" PlaceholderText="例如 2:3 或 1024x1024" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="图片分辨率（优先于质量，留空禁用）" /><TextBox Text="{Binding ImageResolution, Mode=TwoWay}" PlaceholderText="例如 1k 或 2k" /></StackPanel>
                    </Grid>
                    <StackPanel Spacing="5"><TextBlock Text="图片质量（分辨率留空时使用）" /><TextBox Text="{Binding ImageQuality, Mode=TwoWay}" PlaceholderText="例如 high" /></StackPanel>
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="图片超时（秒）" /><NumberBox Value="{Binding ImageTimeoutSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="5xx 重试次数" /><NumberBox Value="{Binding ImageRetryAttempts, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" /></StackPanel>
                        <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="每 Key 最大并发（0 为不限）" /><NumberBox Value="{Binding ImageMaxConcurrentPerKey, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="首次任务轮询延迟（秒）" /><NumberBox Value="{Binding ImagePollInitialDelaySeconds, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" /></StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="任务轮询间隔（秒）" /><NumberBox Value="{Binding ImagePollIntervalSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" /></StackPanel>
                        <CheckBox Grid.Column="1" Content="允许接口官方回退" IsChecked="{Binding ImageOfficialFallback, Mode=TwoWay}" VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Spacing="5"><TextBlock Text="图片提示词模板（可用 {summary}，留空使用默认）" /><TextBox Text="{Binding ImagePromptTemplate, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" /></StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="备用供应商路由（主供应商失败后按顺序尝试；密钥仅在保存时写入，不会回显）" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ProviderFallbacksJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono" FontSize="13" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>

                <Expander Header="高级配置（请求体覆写、提示词与未覆盖字段）" IsExpanded="False">
                    <StackPanel Spacing="10" Padding="0,12,0,0">
                        <TextBlock Text="这里保留完整 TOML；普通配置请优先用上方表单。保存前会由 Rust 使用主程序相同规则校验。" TextWrapping="Wrap" Opacity="0.72" />
                        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="从 TOML 载入表单" Click="LoadForm_Click" /><Button Content="保存高级 TOML" Click="SaveRaw_Click" /></StackPanel>
                        <TextBox Text="{Binding ConfigText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono" FontSize="13" TextWrapping="NoWrap" AcceptsReturn="True" MinHeight="360" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
