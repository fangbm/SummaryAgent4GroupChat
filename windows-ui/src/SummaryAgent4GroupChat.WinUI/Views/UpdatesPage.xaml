<Page
    x:Class="SummaryAgent4GroupChat.WinUI.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28">
        <StackPanel Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="更新与依赖" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="启动后会静默检查应用本体、独立 wxdb 和当前 Python 虚拟环境中的全部 pip 依赖。点击可更新项的“更新”按钮后才会下载或修改组件。" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource StatusCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="运行依赖" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding DependencyStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="安装微信运行环境" Click="InstallRuntime_Click" />
                        <Button Content="运行 wxdb init" Click="WxdbInit_Click" />
                        <Button Content="打开输出目录" Click="OpenOutput_Click" />
                        <Button Content="重新检测" Click="CheckDependencies_Click" />
                    </StackPanel>
                    <TextBlock Text="点击后会打开进度弹窗并在后台执行；安装运行环境和 wxdb init 会单独申请管理员权限，日常 GUI 与主程序保持普通权限。" Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatusCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="检查更新" Click="CheckUpdates_Click" Style="{StaticResource AccentButtonStyle}" />
                        <ProgressRing Width="20" Height="20" IsActive="{Binding IsCheckingUpdates}" />
                        <TextBlock Text="{Binding UpdateCheckStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="更新需要逐项确认：wxdb 与 pip 更新会在后台执行，主程序更新会下载并启动新版 Inno 安装器。" Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ListView ItemsSource="{Binding UpdateItems}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatusCard}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="18" RowSpacing="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="当前版本" Opacity="0.58" /><TextBlock Text="{Binding CurrentVersion}" TextWrapping="Wrap" /></StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="最新版本" Opacity="0.58" /><TextBlock Text="{Binding LatestVersion}" TextWrapping="Wrap" /></StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6">
                                    <TextBlock Text="{Binding Status}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                                    <Button Content="更新" Click="InstallUpdate_Click" IsEnabled="{Binding CanInstall}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Detail}" Opacity="0.72" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
