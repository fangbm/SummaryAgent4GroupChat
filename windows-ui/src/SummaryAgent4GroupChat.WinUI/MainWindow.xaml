<Window
    x:Class="SummaryAgent4GroupChat.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SummaryAgent4GroupChat">
    <NavigationView
        x:Name="Navigation"
        PaneTitle="SummaryAgent4GroupChat"
        IsBackButtonVisible="Collapsed"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="仪表盘" Tag="dashboard" IsSelected="True" />
            <NavigationViewItem Content="接入平台" Tag="platform" />
            <NavigationViewItem Content="监听与命令" Tag="listen" />
            <NavigationViewItem Content="定时总结" Tag="schedule" />
            <NavigationViewItem Content="模型与媒体" Tag="models" />
            <NavigationViewItem Content="运行信息" Tag="runtime" />
            <NavigationViewItem Content="更新与依赖" Tag="updates" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="刷新" Tag="refresh" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
